{
  "name": "sara.recv",
  "version": "1.0.0",
  "description": "A passwordless authentication system.",
  "author": "Taiwan Web Technology Promotion Organization",
  "license": "MIT",
  "main": "app.js",
  "scripts": {
    "export-openapi": "node export_openapi.js",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:es:fix": "eslint \"*.js\" \"src/**/*.js\" --fix",
    "test": "bun test",
    "cover": "nyc mocha test --recursive --timeout 5000 --exit",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@simplewebauthn/server": "^11.0.0",
    "@simplewebauthn/types": "^11.0.0",
    "@sinclair/typebox": "^0.34.49",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.1",
    "express": "^4.18.2",
    "express-validator": "^6.14.3",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "mongoose-to-swagger": "^1.4.0",
    "nanoid": "^3.3.4",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.7.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.2",
    "ua-parser-js": "^1.0.39"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.17.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "husky": "^8.0.1",
    "lint-staged": "^13.2.0",
    "mocha": "^10.0.0",
    "mocha-steps": "^1.3.0",
    "nodemon": "^2.0.13",
    "nyc": "^15.1.0",
    "supertest": "^6.2.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
